# ==============================================================================
# Raizul Forest Validator - Plantilla de Variables de Entorno
# Copia este archivo a backend/.env para desarrollo local
# ==============================================================================

# Llave de acceso a Global Forest Watch Data API (obtener en gfw.globalforestwatch.org)
GFW_API_KEY=tu_gfw_api_key_aqui

# Cabecera Origin autorizada para el cortafuegos de GFW
GFW_ORIGIN_HEADER=https://www.globalforestwatch.org

# URL Base de GFW Data API
GFW_DATA_API_BASE=https://data-api.globalforestwatch.org

# Configuración de Datasets
GFW_DATASET=umd_tree_cover_loss
GFW_DATASET_VERSION=latest

# Timeout en segundos para queries satelitales
GFW_TIMEOUT_SECONDS=35.0

# Orígenes permitidos para CORS (separados por coma o * para desarrollo)
ALLOWED_ORIGINS=*

# Configuración del servidor
PORT=8080
HOST=0.0.0.0
